/// An orchestrator run, recorded before it starts. The run ID is derived from the
/// prompt (lib/agent-run-server.ts), so a replayed prompt collides here and is
/// refused instead of run twice.
///
/// No relation to `Project`: deletion tombstones the project row rather than
/// removing it (lib/project-lifecycle.ts), so there is nothing for a cascade to
/// clean up and a foreign key would only add a write-time constraint.
model TaskRun {
  id String @id @default(cuid())

  /// Orchestrator run ID. Unique, which is what dedupes replays.
  runId String @unique

  projectId String
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, projectId])
}

/// One rolling request window per Clerk user. Updated through one conditional
/// PostgreSQL upsert so parallel serverless requests cannot race past the cap.
model AiRequestRateLimit {
  userId          String   @id
  windowStartedAt DateTime
  requestCount    Int
  updatedAt       DateTime
}
