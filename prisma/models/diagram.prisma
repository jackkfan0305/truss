/// A system architecture graph in its own Liveblocks room. Valid on its own
/// with no storyboard pointing at it (see CONTEXT.md), which is what every
/// diagram the MCP tools create starts out as.
///
/// `id` is one value doing three jobs: this primary key, the
/// `/editor/[roomId]` segment, and the Liveblocks room ID.
model Diagram {
  id             String  @id @default(cuid())
  ownerId        String
  name           String
  canvasJsonPath String?

  /// The storyboard this diagram is a panel on, or `null` for a standalone
  /// one. `SetNull` rather than `Cascade`: deleting the plan a diagram was
  /// drawn for must not delete the diagram.
  storyboardId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deletion tombstone. A diagram ID is never reused, so deletion stamps
  /// `deletingAt`, deletes the Liveblocks room, then stamps `deletedAt`.
  /// Either stamp makes the diagram inaccessible and excludes it from lists;
  /// a `deletingAt` without a `deletedAt` is a cleanup the owner may retry.
  /// Timestamps rather than a lifecycle enum: they say *when*, which a
  /// `DELETING` state never could.
  deletingAt DateTime?
  deletedAt  DateTime?

  storyboard Storyboard? @relation(fields: [storyboardId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([createdAt])
  @@index([storyboardId])
}
