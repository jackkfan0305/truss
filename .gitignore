# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/generated

# Agent tooling is local to a checkout, not part of the project. .claude/ is
# per-agent config (its truss-diagram entry is only a symlink into .agents/),
# and .superpowers/ is planning prose no build step reads.
/.claude/
/.superpowers/

# Skills installed from upstream repos — skills-lock.json pins the source and
# content hash, so re-fetch rather than vendor the reference files. The
# lockfile itself stays tracked; without it the pins are lost.
/.agents/skills/*
# truss-diagram is authored here, not fetched, and `npx skills add
# jackkfan0305/truss --skill truss-diagram` serves it straight out of this
# repo — so it must stay tracked. A new file under an ignored path would
# otherwise be silently left out of every commit.
!/.agents/skills/truss-diagram/

.trigger