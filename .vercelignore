# Vercel CLI deploys upload the working directory against this file *instead of*
# .gitignore, so anything not listed here is sent — secrets included.
#
# .env* is the one that must never be dropped. Vercel refuses to store the
# contents of an uploaded .env, but the entry still exists in the deployment, so
# the build container ends up with a dangling `.env` symlink. Next then scans
# the project root for root-level route files (getFilesInDir), stats the
# symlink, and the build dies with `ENOENT: stat '/vercel/path0/.env'`.
# Production values reach the build through the project's environment
# variables — see scripts/push-vercel-env.ts.
.env*

# Build artifacts, regenerated by `npm run vercel-build`.
.next
.trigger
generated

# Agent tooling and prose; nothing in the build reads them.
.claude
.agents
.superpowers
docs
context
