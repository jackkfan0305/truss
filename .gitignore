# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/generated

# .superpowers/ is planning prose no build step reads.
/.superpowers/

# .claude/ is per-agent config. settings.local.json is one developer's machine
# and stays out; skills/ is the symlink farm Claude Code reads and is tracked
# (see below), so this ignores the directory's contents rather than the
# directory itself.
/.claude/*
!/.claude/skills/

# Agent skills are vendored, not re-fetched. skills-lock.json still pins the
# source and content hash of everything under .agents/skills/ that came from
# upstream, but the files themselves are tracked so a fresh worktree has
# working skills with no setup step — re-fetching left the three checkouts
# holding different sets. .claude/skills/ is one relative symlink per skill
# into .agents/skills/, which resolves the same in every worktree, so there is
# exactly one copy of each skill on disk.
#
# Refresh with `npx skills`, then commit the diff like any other change.
#
# /agent/ is a stray third copy some skills tooling has written in the past.
# Nothing reads it and it duplicates .agents/skills/, so it never gets tracked.
/agent/
