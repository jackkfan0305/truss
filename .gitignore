# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/generated

# .superpowers/ is planning prose no build step reads.
/.superpowers/

# Per-agent-tool directories. Each one is a symlink farm pointing into
# .agents/skills/ plus that tool's own local config, so it is a rendering of
# the skills rather than the skills themselves — and settings.local.json under
# .claude/ is one developer's machine. Regenerate any of them with
# `npm run skills:link`.
/.claude/
/.codex/
/agent/

# The skills themselves are vendored, one copy, under .agents/skills/.
# skills-lock.json stays as the provenance record for everything that came
# from upstream, but the files are tracked so a fresh worktree has them
# without a fetch — re-fetching left the three checkouts holding different
# sets. Refresh with `npx skills`, then commit the diff like any other change.
