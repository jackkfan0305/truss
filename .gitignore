# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/generated

# agent skills installed from an upstream repo — skills-lock.json pins the
# source and content hash, so re-fetch rather than vendor ~50 reference files.
# The lockfile itself stays tracked; without it the pins are lost.
# react-doctor predates this and is already tracked, so these rules do not
# affect it — .gitignore never applies to tracked files. The negations are
# there so it does not silently vanish if it is ever removed and re-added.
/.agents/skills/*
/.claude/skills/*
!/.agents/skills/react-doctor/
!/.claude/skills/react-doctor/

.trigger